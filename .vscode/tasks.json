{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prek",
      "type": "shell",
      "command": "prek",
      "args": ["run", "--from-ref", "origin/master", "--to-ref", "HEAD"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npm",
      "args": ["run", "typecheck"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true
    },
    {
      "label": "Build APK",
      "type": "shell",
      "command": "npm",
      "args": ["run", "apk"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
